@model List<RoomBooking.Models.Booking>

@{
    var room = ViewBag.Room as RoomBooking.Models.Room;
    var date = (DateTime)ViewBag.Date;
    ViewData["Title"] = $"Bookings for {room?.Name}";

    // Business hours: 08:00 to 18:00 (10 hours = 600 minutes)
    var dayStart = date.Date.AddHours(8);
    int totalMinutes = 600;
}

<h1>Bookings for @room?.Name — @date.ToString("d MMM yyyy")</h1>

<style>
    .timeline-wrapper {
        display: flex;
        border: 1px solid #ccc;
        max-width: 700px;
    }

    .timeline-hours {
        width: 60px;
        border-right: 1px solid #ccc;
    }

    .timeline-hour-label {
        height: 60px;
        box-sizing: border-box;
        border-bottom: 1px solid #eee;
        font-size: 0.8em;
        color: #666;
        padding: 4px;
    }

    .timeline-track {
        position: relative;
        flex-grow: 1;
        height: @(totalMinutes)px;
        background-image: repeating-linear-gradient(
            to bottom,
            #f5f5f5,
            #f5f5f5 59px,
            #eee 60px
        );
    }

    .booking-block {
        position: absolute;
        left: 8px;
        right: 8px;
        background-color: #4a90d9;
        color: white;
        border-radius: 4px;
        padding: 4px 8px;
        box-sizing: border-box;
        font-size: 0.85em;
        overflow: hidden;
    }
</style>

@if (!Model.Any())
{
    <p>No bookings for this room on this date.</p>
}
else
{
    <div class="timeline-wrapper">
        <div class="timeline-hours">
            @for (int hour = 8; hour < 18; hour++)
            {
                <div class="timeline-hour-label">@hour:00</div>
            }
        </div>
        <div class="timeline-track">
            @foreach (var booking in Model)
            {
                int startMinutes = (int)(booking.StartTime - dayStart).TotalMinutes;
                int durationMinutes = (int)(booking.EndTime - booking.StartTime).TotalMinutes;

                <div class="booking-block" style="top: @(startMinutes)px; height: @(durationMinutes)px;">
                    <strong>@booking.OrganizerName</strong><br />
                    @booking.StartTime.ToString("t") - @booking.EndTime.ToString("t")
                </div>
            }
        </div>
    </div>
}